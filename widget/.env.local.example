
# Provide your WalletConnect project ID to allow access to WalletConnect Cloud.
# VITE_PUBLIC_SENTRY_DSN=
VITE_PUBLIC_WALLETCONNECT_PROJECT_ID=
VITE_PUBLIC_SUBSCAN_KEY=
VITE_PUBLIC_ALCHEMY_KEY=
# Optional public JSON map of ParaSpell chain names to local/custom WebSocket RPC URLs. Explicit entries
# replace Turtle's Hydration fallback or ParaSpell's defaults. Do not include secrets.
# Example: {"Hydration":"wss://your-rpc.example"}
VITE_PUBLIC_PARASPELL_RPC_OVERRIDES=
VITE_PUBLIC_ENVIRONMENT= # eg: 'mainnet'
VITE_PUBLIC_FIREBASE_PROJECT_ID= # eg: 'app-turtle-cool'
VITE_PUBLIC_MELD_API_KEY=
VITE_ANALYTICS_DASHBOARD_BASE_URL= # eg: 'https://analytics.turtle.cool'
VITE_ANALYTICS_WIDGET_AUTH_TOKEN=
VITE_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
